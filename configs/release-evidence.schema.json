{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NeuroTerrarium local release evidence",
  "description": "Structural schema only. Passing requires the executable validator to verify actual artifacts and measured states. Incomplete statuses are representable but cannot pass the release gate.",
  "type": "object",
  "required": [
    "schema",
    "phase",
    "candidate",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "neuroterrarium.release-evidence.v1"
    },
    "phase": {
      "const": "local"
    },
    "candidate": {
      "type": "object",
      "required": [
        "source",
        "training_sources",
        "configs",
        "model_manifest"
      ],
      "properties": {
        "source": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/file"
          }
        },
        "training_sources": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/file"
          }
        },
        "configs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/file"
          }
        },
        "model_manifest": {
          "$ref": "#/$defs/file"
        }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "object",
      "required": [
        "data",
        "neural",
        "cache_equivalence",
        "training",
        "core_tests",
        "lint",
        "typecheck",
        "build",
        "runtime",
        "evaluation",
        "supplement",
        "ui",
        "stability",
        "installed_wheel",
        "portable",
        "public_review"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/item"
        },
        "neural": {
          "$ref": "#/$defs/item"
        },
        "cache_equivalence": {
          "$ref": "#/$defs/item"
        },
        "training": {
          "$ref": "#/$defs/item"
        },
        "core_tests": {
          "$ref": "#/$defs/item"
        },
        "lint": {
          "$ref": "#/$defs/item"
        },
        "typecheck": {
          "$ref": "#/$defs/item"
        },
        "build": {
          "$ref": "#/$defs/item"
        },
        "runtime": {
          "$ref": "#/$defs/item"
        },
        "evaluation": {
          "$ref": "#/$defs/item"
        },
        "supplement": {
          "$ref": "#/$defs/item"
        },
        "ui": {
          "$ref": "#/$defs/item"
        },
        "stability": {
          "$ref": "#/$defs/item"
        },
        "installed_wheel": {
          "$ref": "#/$defs/item"
        },
        "portable": {
          "$ref": "#/$defs/item"
        },
        "public_review": {
          "$ref": "#/$defs/item"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "file": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Relative normalized POSIX path inside artifact root. The executable verifier rejects absolute paths, traversal and symlinks."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": [
        "status",
        "command",
        "exit_code",
        "log",
        "summary",
        "identity"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_run",
            "running",
            "completed",
            "failed",
            "skipped"
          ]
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "log": {
          "$ref": "#/$defs/file"
        },
        "summary": {
          "$ref": "#/$defs/file"
        },
        "identity": {
          "type": "object",
          "required": [
            "source_sha256",
            "config_sha256",
            "model_manifest_sha256"
          ],
          "properties": {
            "source_sha256": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "description": "Recorded dependency subset. Category-specific mandatory keys are enforced by the executable verifier."
            },
            "config_sha256": {
              "type": "object",
              "minProperties": 0,
              "additionalProperties": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "model_manifest_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        }
      },
      "additionalProperties": true,
      "description": "Additional category-specific references and detailed native summary semantics are checked by validate_release.py."
    }
  }
}
